<%- include('../partials/header') %>
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--ucrs-bg);">
  <div style="text-align:center;padding:40px;">
    <div style="font-size:6rem;font-weight:800;color:var(--ucrs-danger);opacity:0.15;line-height:1;">500</div>
    <h1 style="font-size:1.5rem;font-weight:700;color:var(--ucrs-gray-800);margin:12px 0 8px;">Server Error</h1>
    <p style="color:var(--ucrs-text-muted);margin-bottom:12px;">Something went wrong on our end.</p>
    <% if (typeof message !== 'undefined' && message) { %>
      <div style="background:var(--ucrs-danger-bg);border:1px solid #fca5a5;border-radius:8px;padding:12px 16px;font-size:0.875rem;color:#9b1c1c;max-width:500px;margin:0 auto 20px;text-align:left;font-family:monospace;"><%= message %></div>
    <% } %>
    <a href="/" class="ucrs-btn ucrs-btn--primary">← Go Home</a>
  </div>
</div>
<%- include('../partials/footer') %>
