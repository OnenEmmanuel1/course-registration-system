<%- include('../partials/header') %>
<div class="ucrs-shell">
  <%- include('../partials/navbar-admin') %>
  <main class="ucrs-main">
    <%- include('../partials/flash-messages') %>
    <div class="ucrs-topbar">
      <button id="ucrs-sidebar-toggle" style="background:none;border:none;cursor:pointer;padding:4px;">☰</button>
      <span class="ucrs-topbar__title">Password Reset Requests</span>
      <div class="ucrs-topbar__user"><%- include('../partials/avatar') %><span><%= user.name %></span></div>
    </div>
    <div class="ucrs-content">
      <div class="ucrs-page-header"><h1>Password Reset Requests</h1><p>Set a temporary password for users who cannot access their account.</p></div>
      <% if (!requests.length) { %>
        <div class="ucrs-card"><div class="ucrs-card__body">There are no pending password reset requests.</div></div>
      <% } else { requests.forEach(function(request) { %>
        <section class="ucrs-card" style="margin-bottom:16px;">
          <div class="ucrs-card__body">
            <h2 style="margin-top:0;"><%= request.name %></h2>
            <p><%= request.email %> · <%= request.role %> · Requested <%= new Date(request.created_at).toLocaleString() %></p>
            <form action="/admin/password-resets/<%= request.id %>" method="POST">
              <%- include('../partials/password-field', { id: 'temporary-password-' + request.id, name: 'temporary_password', label: 'Temporary password (at least 8 characters)', autocomplete: 'new-password' }) %>
              <%- include('../partials/password-field', { id: 'confirm-password-' + request.id, name: 'confirm_password', label: 'Confirm temporary password', autocomplete: 'new-password' }) %>
              <button class="ucrs-btn ucrs-btn--primary" type="submit">Set Temporary Password</button>
            </form>
          </div>
        </section>
      <% }); } %>
    </div>
    <%- include('../partials/footer') %>
  </main>
</div>
