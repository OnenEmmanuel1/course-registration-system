<%- include('../partials/header') %>
<div class="ucrs-shell">
  <%- include('../partials/navbar-admin') %>
  <main class="ucrs-main">
    <div class="ucrs-topbar">
      <button id="ucrs-sidebar-toggle" style="background:none;border:none;cursor:pointer;padding:4px;">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="width:24px;height:24px;color:var(--ucrs-gray-600)"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <span class="ucrs-topbar__title">Users</span>
      <div class="ucrs-topbar__user">
        <div class="ucrs-avatar ucrs-avatar--admin"><%= user.name.charAt(0).toUpperCase() %></div>
        <span><%= user.name %></span>
      </div>
    </div>

    <div class="ucrs-content">
      <div class="ucrs-page-header"><h1>User Management</h1><p>All registered users in the system.</p></div>

      <!-- Role Filter -->
      <div class="ucrs-filters">
        <a href="/admin/users" class="ucrs-btn <%= !filterRole ? 'ucrs-btn--primary' : 'ucrs-btn--ghost' %> ucrs-btn--sm">All</a>
        <a href="/admin/users?role=student" class="ucrs-btn <%= filterRole === 'student' ? 'ucrs-btn--success' : 'ucrs-btn--ghost' %> ucrs-btn--sm">Students</a>
        <a href="/admin/users?role=lecturer" class="ucrs-btn <%= filterRole === 'lecturer' ? 'ucrs-btn--outline' : 'ucrs-btn--ghost' %> ucrs-btn--sm">Lecturers</a>
        <a href="/admin/users?role=admin" class="ucrs-btn <%= filterRole === 'admin' ? 'ucrs-btn--warning' : 'ucrs-btn--ghost' %> ucrs-btn--sm">Admins</a>
      </div>

      <div class="ucrs-card">
        <div class="ucrs-card__header">
          <span class="ucrs-card__title"><%= users.length %> user(s)</span>
        </div>
        <div class="ucrs-table-wrap">
          <table class="ucrs-table">
            <thead>
              <tr><th>Name</th><th>Email</th><th>Role</th><th>Department</th><th>Level/ID</th><th>Joined</th></tr>
            </thead>
            <tbody>
              <% users.forEach(function(u) { %>
              <tr>
                <td>
                  <div style="display:flex;align-items:center;gap:8px;">
                    <div class="ucrs-avatar ucrs-avatar--<%= u.role %>" style="width:30px;height:30px;font-size:0.75rem;">
                      <%= u.name.charAt(0).toUpperCase() %>
                    </div>
                    <strong><%= u.name %></strong>
                  </div>
                </td>
                <td><%= u.email %></td>
                <td><span class="ucrs-role-pill ucrs-role-pill--<%= u.role %>"><%= u.role %></span></td>
                <td><%= u.department || '—' %></td>
                <td>
                  <% if (u.role === 'student') { %>
                    <div style="font-size:0.8rem;">Level <%= u.level || '—' %></div>
                    <div style="font-size:0.75rem;color:var(--ucrs-text-muted);"><%= u.matric_no || '' %></div>
                  <% } else { %>
                    <span style="font-size:0.8rem;"><%= u.staff_id || '—' %></span>
                  <% } %>
                </td>
                <td><%= new Date(u.created_at).toLocaleDateString() %></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <%- include('../partials/footer') %>
  </main>
</div>