<%- include('../partials/header') %>
<div class="ucrs-shell">
  <%- include('../partials/navbar-admin') %>
  <main class="ucrs-main">
    <div class="ucrs-topbar">
      <button id="ucrs-sidebar-toggle" style="background:none;border:none;cursor:pointer;padding:4px;">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="width:24px;height:24px;color:var(--ucrs-gray-600)"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <span class="ucrs-topbar__title">Course Management</span>
      <div class="ucrs-topbar__user">
        <div class="ucrs-avatar ucrs-avatar--admin"><%= user.name.charAt(0).toUpperCase() %></div>
        <span><%= user.name %></span>
      </div>
    </div>

    <div class="ucrs-content">
      <% if (flash.success && flash.success.length) { %>
        <div class="ucrs-alert ucrs-alert--success"><span><%= flash.success[0] %></span></div>
      <% } %>
      <% if (flash.error && flash.error.length) { %>
        <div class="ucrs-alert ucrs-alert--error"><span><%= flash.error[0] %></span></div>
      <% } %>

      <div class="ucrs-page-header"><h1>Manage Courses</h1></div>

      <div class="ucrs-courses-layout" style="display:grid;grid-template-columns:minmax(0,1fr) 380px;gap:24px;align-items:start;">
        <!-- Course List -->
        <div class="ucrs-card">
          <div class="ucrs-card__header">
            <span class="ucrs-card__title"><%= courses.length %> Course(s)</span>
          </div>
          <div class="ucrs-table-wrap ucrs-table-wrap--courses">
            <table class="ucrs-table ucrs-course-table">
              <colgroup>
                <col class="ucrs-course-col-code" /><col class="ucrs-course-col-title" />
                <col class="ucrs-course-col-dept" /><col class="ucrs-course-col-level" />
                <col class="ucrs-course-col-credits" /><col class="ucrs-course-col-prereq" />
                <col class="ucrs-course-col-actions" />
              </colgroup>
              <thead>
                <tr><th>Code</th><th>Title</th><th>Dept</th><th>Lvl</th><th>Credits</th><th>Prerequisites</th><th>Actions</th></tr>
              </thead>
              <tbody>
                <% courses.forEach(function(c) { %>
                <tr>
                  <td><span class="ucrs-badge ucrs-badge--primary"><%= c.code %></span></td>
                  <td><strong><%= c.title %></strong></td>
                  <td><%= c.department %></td>
                  <td>L<%= c.level %></td>
                  <td><span class="ucrs-badge ucrs-badge--gray"><%= c.credit_units %></span></td>
                  <td><span style="font-size:0.8rem;color:var(--ucrs-lecturer)"><%= c.prereq_codes || 'None' %></span></td>
                  <td>
                    <div class="ucrs-course-actions">
                      <a href="/admin/courses/<%= c.id %>/edit#course-form" class="ucrs-btn ucrs-btn--ghost ucrs-btn--sm">Edit</a>
                      <a href="/admin/assignments?course_id=<%= c.id %>" class="ucrs-btn ucrs-btn--ghost ucrs-btn--sm">Assign Lecturer</a>
                      <form action="/admin/courses/<%= c.id %>/delete" method="POST" style="display:inline;">
                        <button type="submit" class="ucrs-btn ucrs-btn--danger ucrs-btn--sm"
                          data-confirm="Delete course '<%= c.code %>'? This will also remove prerequisite links.">Delete</button>
                      </form>
                    </div>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Create / Edit Form -->
        <div class="ucrs-card" id="course-form" style="position:sticky;top:80px;">
          <div class="ucrs-card__header">
            <span class="ucrs-card__title"><%= editCourse ? 'Edit Course' : 'Create New Course' %></span>
            <% if (editCourse) { %><a href="/admin/courses" class="ucrs-btn ucrs-btn--ghost ucrs-btn--sm">Cancel</a><% } %>
          </div>
          <div class="ucrs-card__body">
            <form action="<%= editCourse ? '/admin/courses/' + editCourse.id + '/update' : '/admin/courses/create' %>" method="POST">
              <div class="ucrs-form-group">
                <label class="ucrs-label ucrs-label--required">Course Code</label>
                <input type="text" name="code" class="ucrs-input" required placeholder="e.g. CSC301"
                  value="<%= editCourse ? editCourse.code : '' %>" />
              </div>
              <div class="ucrs-form-group">
                <label class="ucrs-label ucrs-label--required">Title</label>
                <input type="text" name="title" class="ucrs-input" required placeholder="Course Title"
                  value="<%= editCourse ? editCourse.title : '' %>" />
              </div>
              <div class="ucrs-form-row">
                <div class="ucrs-form-group">
                  <label class="ucrs-label ucrs-label--required">Credits</label>
                  <input type="number" name="credit_units" class="ucrs-input" required min="1" max="6"
                    value="<%= editCourse ? editCourse.credit_units : 3 %>" />
                </div>
                <div class="ucrs-form-group">
                  <label class="ucrs-label ucrs-label--required">Level</label>
                  <select name="level" class="ucrs-select" required>
                    <% [100,200,300,400].forEach(function(l) { %>
                      <option value="<%= l %>" <%= editCourse && editCourse.level == l ? 'selected' : '' %>>Level <%= l %></option>
                    <% }); %>
                  </select>
                </div>
              </div>
              <div class="ucrs-form-group">
                <label class="ucrs-label ucrs-label--required">Department</label>
                <select name="department" class="ucrs-select" required>
                  <option value="">Select a department</option>
                  <% departments.forEach(function(item) { %>
                    <option value="<%= item.department %>" <%= editCourse && editCourse.department === item.department ? 'selected' : '' %>><%= item.department %></option>
                  <% }); %>
                </select>
                <small class="ucrs-text-muted">Need another department? Add it under <a href="/admin/settings">Admin Settings</a>.</small>
              </div>
              <div class="ucrs-form-group">
                <label class="ucrs-label">Description</label>
                <textarea name="description" class="ucrs-textarea" rows="3" placeholder="Brief course description"><%= editCourse ? editCourse.description || '' : '' %></textarea>
              </div>
              <div class="ucrs-form-group">
                <label class="ucrs-label">Prerequisites (select multiple)</label>
                <div class="ucrs-checkbox-list">
                  <% allCourses.forEach(function(p) { %>
                    <% if (!editCourse || p.id !== editCourse.id) { %>
                    <label class="ucrs-checkbox-item">
                      <input type="checkbox" name="prerequisite_ids" value="<%= p.id %>"
                        <%= editCourse && editCourse.prereq_ids && editCourse.prereq_ids.includes(p.id) ? 'checked' : '' %> />
                      <span><%= p.code %> — <%= p.title %></span>
                    </label>
                    <% } %>
                  <% }); %>
                </div>
              </div>
              <button type="submit" class="ucrs-btn ucrs-btn--primary ucrs-btn--full">
                <%= editCourse ? 'Update Course' : 'Create Course' %>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
    <%- include('../partials/footer') %>
  </main>
</div>
