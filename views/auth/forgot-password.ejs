<%- include('../partials/header') %>
<div class="ucrs-login-page">
  <section class="ucrs-login__panel" style="max-width:520px;margin:auto;">
    <div class="ucrs-login__brand">
      <div class="ucrs-login__brand-icon">U</div>
      <div><div class="ucrs-login__brand-name">UCRSystem</div><div class="ucrs-login__brand-sub">UNICROSS University</div></div>
    </div>
    <%- include('../partials/flash-messages') %>
    <h1>Forgot your password?</h1>
    <p class="ucrs-login__sub">Enter your account email. An administrator can issue a temporary password after verifying your identity.</p>
    <form action="/forgot-password" method="POST">
      <div class="ucrs-form-group">
        <label for="reset-email" class="ucrs-label ucrs-label--required">Email address</label>
        <input id="reset-email" name="email" type="email" class="ucrs-input" autocomplete="email" required />
      </div>
      <button type="submit" class="ucrs-btn ucrs-btn--primary ucrs-btn--full">Request password reset</button>
    </form>
    <p style="margin:20px 0 0;text-align:center;"><a href="/login">Back to sign in</a></p>
  </section>
</div>
<%- include('../partials/footer') %>
